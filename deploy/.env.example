# ═══════════════════════════════════════════════════════════════════
# deploy/.env  — 이 파일을 복사해 .env 를 만든다:  cp .env.example .env
# 🔴 .env 는 **절대 커밋하지 않는다**(이 저장소는 public). chmod 600 .env
# 상세 설명: SPEC.md 부록 A
# ═══════════════════════════════════════════════════════════════════

# ── DB ──────────────────────────────────────────────────────────────
# 32자 이상 무작위. 예: openssl rand -base64 32 | tr -d '=+/'
POSTGRES_PASSWORD=

# ── 키 3종 — scripts/gen-keys.sh 출력을 그대로 붙인다 ──────────────
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ── 주소 ────────────────────────────────────────────────────────────
PUBLIC_URL=https://shielduslab.com
SERVER_NAME=shielduslab.com www.shielduslab.com
# 정적 사이트 루트(기본: 레포 루트). deploy/ 기준 상대경로
SITE_ROOT=../

# ── 메일(비밀번호 재설정용, 선택) ───────────────────────────────────
MAILER_AUTOCONFIRM=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
